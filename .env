PORT=8080
ENVIRONMENT=development

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=011202
DB_NAME=trackme
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5

# JWT configuration
JWT_ACCESS_SECRET=super-secret-access-token-key-change-me
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-me
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=7

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Rate limiting
RATE_LIMIT_RPM=60